{
    // ==========================================================================
    // 1. 通用编辑器与工作台设置 (General Editor & Workbench)
    // ==========================================================================
    "workbench.colorTheme": "Winter is Coming (Dark Black - No Italics)",
    "workbench.editor.empty.hint": "hidden",
    "glassit.alpha": 255, // 窗口透明度
    
    // —— 补全与提示逻辑 ——
    "editor.quickSuggestions": {
        "other": true,
        "comments": true,
        "strings": false
    },
    "editor.wordBasedSuggestions": "off",
    "editor.inlineSuggest.enabled": true,
    "editor.parameterHints.enabled": true,
    "editor.suggest.localityBonus": true,
    "editor.acceptSuggestionOnEnter": "on",

    // —— 文件关联与排除 ——
    "files.associations": {
        "*.tex": "latex",
        "*.cls": "latex",
        "*.sty": "latex",
        "*.bib": "bibtex"
    },
    "files.exclude": {
        "**/*.synctex.gz": true
    },

    // ==========================================================================
    // 2. 终端设置 (Terminal Configuration)
    // ==========================================================================
    "terminal.integrated.fontFamily": " Cascadia Mono, 'Microsoft YaHei UI', 'SimSun'",
    "terminal.integrated.defaultProfile.windows": "PowerShell (UTF-8)",
    "terminal.integrated.enableVisualBell": false,
    "accessibility.signals.terminalBell": { "sound": "off" },
    "terminal.integrated.accessibleViewFocusOnCommandExecution": true,
    "terminal.external.windowsExec": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
    
    "terminal.integrated.profiles.windows": {
        // ---- CMD (UTF-8) ----
        // "CMD (UTF-8)": {
        //     "path": "C:\\Windows\\System32\\cmd.exe",
        //     "args": ["/k", "chcp 65001"]
        // },
        "PowerShell (UTF-8)": {
            "source": "PowerShell",
            "args": [
                "-NoExit",
                "-Command",
                "[Console]::OutputEncoding=[Text.UTF8Encoding]::new(); chcp 65001"
            ]
        }
    },

    // ==========================================================================
    // 3. C/C++ 开发环境 (C/C++ Environment)
    // ==========================================================================
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.autocomplete": "default",
    "C_Cpp.default.compilerPath": "D:/Personal_Software/mingw64/bin/gcc.exe",
    "C_Cpp.default.cStandard": "c17",
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
    "C_Cpp.default.compilerArgs": [
        "-Wall",
        "-Wpedantic",
        "-Wextra"
    ],
    "C_Cpp.default.includePath": [
        "D:/Personal_Software/mingw64/include",
        "D:/Personal_Software/mingw64/x86_64-w64-mingw32/include"
    ],

    // ==========================================================================
    // 4. Code Runner 插件设置
    // ==========================================================================
    "code-runner.runInTerminal": true,
    "code-runner.clearPreviousOutput": false,
    "code-runner.ignoreSelection": false,
    "code-runner.saveAllFilesBeforeRun": true,
    "code-runner.fileDirectoryAsCwd": true,
    "code-runner.executorMap": {
        "cpp": "g++ \"$fileName\" -o \"$fileNameWithoutExt.exe\" -std=c++17 -Wall -Wextra; if ($?) { .\\\"$fileNameWithoutExt.exe\" }",
        "c": "gcc \"$fileName\" -o \"$fileNameWithoutExt.exe\" -std=c17 -Wall -Wextra; if ($?) { .\\\"$fileNameWithoutExt.exe\" }",
        // ---- java 程序  --------------------------------------------------
        "java": "cd \"$dir\" && javac \"$fileName\" && java \"$fileNameWithoutExt\"",
        "python": "& python -u \"${fullFileName.replace('\\', '\\\\')}\""
    },

    // ==========================================================================
    // 5. AI 辅助工具 (AI Assistants)
    // ==========================================================================
    "Codegeex.Privacy": true,
    "Codegeex.License": "",
    "tabnine.experimentalAutoImports": true,
    "github.copilot.nextEditSuggestions.enabled": true,

    // ==========================================================================
    // 6. 界面美化 (UI Beautification)
    // ==========================================================================
    "background.enabled": true,

    // "background.fullscreen": {//全屏壁纸
    //     "images": ["file:///C:/Users/Administrator/Desktop/View/海报/Yuki.jpg"],
    //     "opacity": 0.15, 
    //     "size": "cover",
    //     "position": "center"
    // },
    "background.editor": {
        "useFront": true,
        "style": {
            "background-position": "center",
            "background-size": "cover",
            "opacity": 0.15
        },
        "images": [
            "file:///C:/Users/Administrator/Desktop/View/海报/向死而生.jpg"
        ]
    },
    "background.sidebar": {
        "images": [
            "file:///C:/Users/Administrator/Desktop/View/海报/uptotop.jpg"
        ],
        "opacity": 0.2,
        "size": "cover",
        "position": "center"
    },
    "background.panel": {
        "images": [
            "file:///C:/Users/Administrator/Desktop/View/海报/nature.webp"
        ],
        "opacity": 0.15
    },

    // ==========================================================================
    // 7. 版本控制与同步 (Version Control & Sync)
    // ==========================================================================
    "git.autofetch": true,
    "settingsSync.ignoredSettings": [],

    // ==========================================================================
    // 8. LaTeX Workshop 设置 (LaTeX Environment)
    // ==========================================================================
    "[latex]": {
        "editor.formatOnPaste": false,
        "editor.suggestSelection": "recentlyUsedByPrefix"
    },

    // ===================================================================
    // 一、 预览、同步与界面
    // ===================================================================
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",
    "latex-workshop.synctex.afterBuild.enabled": true,
    "latex-workshop.view.pdf.zoom": "page-width",
    "latex-workshop.view.pdf.scrollMode": 0,
    "latex-workshop.view.pdf.spreadMode": 0,
    "latex-workshop.view.pdf.tab.editorGroup": "right",
    "latex-workshop.view.pdf.hand": false,
    "latex-workshop.view.pdf.trim": 0,
    "latex-workshop.view.pdf.reload.transition": "fade",
    "latex-workshop.showContextMenu": true,
    "latex-workshop.intellisense.package.enabled": true,
    "latex-workshop.message.error.show": false,
    "latex-workshop.message.warning.show": false,
    "latex-workshop.message.information.show": false,

    // ===================================================================
    // 二、 输出与构建策略
    // ===================================================================
    "latex-workshop.latex.outDir": "%DIR%/out",
    "latex-workshop.latex.build.forceRecipeUsage": true,
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.watch.pdf.delay": 800,

    // ===================================================================
    // 三、 Root 识别（多文件工程）
    // ===================================================================
    "latex-workshop.latex.rootFile.useSubFile": true,
    "latex-workshop.latex.rootFile.doNotPrompt": true,
    "latex-workshop.latex.search.rootFiles.include": [
        "**/*.tex"
    ],
    "latex-workshop.latex.search.rootFiles.exclude": [
        "**/.git/**",
        "**/node_modules/**",
        "**/.history/**",
        "**/.vscode/**",
        "out/**",
        "latex/**"
    ],

    // ===================================================================
    // 四、 工具链（Tools）定义
    // ===================================================================
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk-aux-only",
            "command": "latexmk",
            "args": [
                "-xelatex",
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-auxdir=%DIR%/out",
                "-outdir=%DIR%/out",
                "-emulate-aux-dir",
                "%DOC%"
            ]
        },
        {
            "name": "latexmk (xelatex)",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-xelatex",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ]
        },
        {
            "name": "latexmk (pdflatex)",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ]
        },
        {
            "name": "latexmk (lualatex)",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-lualatex",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ]
        },
        {
            "name": "latexmk (xelatex + shell-escape)",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-xelatex",
                "-shell-escape",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ]
        },
        {
            "name": "xelatex",
            "command": "xelatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-output-directory=%OUTDIR%",
                "%DOC%"
            ]
        },
        {
            "name": "pdflatex",
            "command": "pdflatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-output-directory=%OUTDIR%",
                "%DOC%"
            ]
        },
        {
            "name": "lualatex",
            "command": "lualatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-output-directory=%OUTDIR%",
                "%DOC%"
            ]
        },
        {
            "name": "biber",
            "command": "biber",
            "args": [
                "%OUTDIR%/%DOCFILE%"
            ]
        },
        {
            "name": "bibtex",
            "command": "bibtex",
            "args": [
                "%OUTDIR%/%DOCFILE%"
            ]
        },
        {
            "name": "makeglossaries",
            "command": "makeglossaries",
            "args": [
                "%OUTDIR%/%DOCFILE%"
            ]
        },
        {
            "name": "makeindex",
            "command": "makeindex",
            "args": [
                "%OUTDIR%/%DOCFILE%"
            ]
        },
        {
            "name": "tectonic (basic)",
            "command": "tectonic",
            "args": [
                "--synctex",
                "--keep-logs",
                "--keep-intermediates",
                "--outdir",
                "%OUTDIR%",
                "%DOC%.tex"
            ]
        },
        {
            "name": "arara",
            "command": "arara",
            "args": [
                "--verbose",
                "--log",
                "--working-directory",
                "%DIR%",
                "%DOC%.tex"
            ]
        },
        {
            "name": "ensure-out-dirs",
            "command": "cmd",
            "args": [
                "/c",
                "robocopy \"%DIR%\" \"%OUTDIR%\" /E /XF * /XD out .git .vscode .history & exit 0"
            ]
        },
        {
            "name": "copy-pdf-to-root",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "$doc = '%DOCFILE%'; $dir = '%DIR%'; $out = '%OUTDIR%'; $synctex = \"$dir\\$doc.synctex.gz\"; if (Test-Path \"$out\\$doc.pdf\") { Copy-Item \"$out\\$doc.pdf\" \"$dir\\$doc.pdf\" -Force }; if (Test-Path \"$out\\$doc.synctex.gz\") { Copy-Item \"$out\\$doc.synctex.gz\" $synctex -Force }; if (Test-Path $synctex) { (Get-Item -LiteralPath $synctex).Attributes = 'Hidden' }"
            ]
        }
    ],

    // ===================================================================
    // 五、 配方（Recipes）组合
    // ===================================================================
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk ▶ PDF（aux→out, pdf→root）",
            "tools": [
                "ensure-out-dirs",
                "latexmk-aux-only",
                "copy-pdf-to-root"
            ]
        },
        {
            "name": "latexmk: xelatex（推荐）",
            "tools": [
                "ensure-out-dirs",
                "latexmk (xelatex)",
                "copy-pdf-to-root"
            ]
        },
        {
            "name": "latexmk: pdflatex",
            "tools": [
                "latexmk (pdflatex)"
            ]
        },
        {
            "name": "latexmk: lualatex",
            "tools": [
                "latexmk (lualatex)"
            ]
        },
        {
            "name": "latexmk: xelatex（shell-escape）",
            "tools": [
                "latexmk (xelatex + shell-escape)"
            ]
        },
        {
            "name": "latexmk → makeglossaries → latexmk",
            "tools": [
                "latexmk (xelatex)",
                "makeglossaries",
                "latexmk (xelatex)"
            ]
        },
        {
            "name": "latexmk → makeindex → latexmk",
            "tools": [
                "latexmk (xelatex)",
                "makeindex",
                "latexmk (xelatex)"
            ]
        },
        {
            "name": "手动：xelatex → biber → xelatex×2",
            "tools": [
                "xelatex",
                "biber",
                "xelatex",
                "xelatex"
            ]
        },
        {
            "name": "手动：pdflatex → bibtex → pdflatex×2",
            "tools": [
                "pdflatex",
                "bibtex",
                "pdflatex",
                "pdflatex"
            ]
        },
        {
            "name": "单次：xelatex",
            "tools": [
                "xelatex"
            ]
        },
        {
            "name": "单次：pdflatex",
            "tools": [
                "pdflatex"
            ]
        },
        {
            "name": "单次：lualatex",
            "tools": [
                "lualatex"
            ]
        },
        {
            "name": "tectonic（快速出活）",
            "tools": [
                "tectonic (basic)"
            ]
        },
        {
            "name": "arara（按文档头部规则）",
            "tools": [
                "arara"
            ]
        }
    ],
    "latex-workshop.latex.recipe.default": "lastUsed",

    // ===================================================================
    // 六、 自动清理（Clean）
    // ===================================================================
    "latex-workshop.latex.autoClean.run": "onBuilt",
    "latex-workshop.latex.clean.method": "glob",
    "latex-workshop.latex.clean.fileTypes": [
        "*.aux",
        "*.log",
        "*.toc",
        "*.lof",
        "*.lot",
        "*.out",
        "*.fls",
        "*.fdb_latexmk",
        "*.bbl",
        "*.bcf",
        "*.blg",
        "*.run.xml",
        "*.idx",
        "*.ind",
        "*.ilg",
        "*.ist",
        "*.acn",
        "*.acr",
        "*.alg",
        "*.glg",
        "*.glo",
        "*.gls",
        "*.snm",
        "*.nav",
        "*.vrb",
        "*.xdv",
        "_minted-*/**",
        "_minted-*/",
        "*.auxlock"
    ],

    // ===================================================================
    // 七、 语法检查（Linting）
    // ===================================================================
    "latex-workshop.linting.chktex.enabled": true,
    "latex-workshop.linting.lacheck.enabled": false,
    "latex-workshop.linting.run": "onType",

    // 【检查】: ChkTeX 参数
    // （可选）你可以在项目根目录放一个 `.chktexrc` 文件来定义检查规则。
    // 下面的参数是示例，例如 `-q` (安静模式), `-I0` (不显示欢迎信息)。
    // "latex-workshop.linting.chktex.exec.args": [
    //         "-wall",   // 开启所有检查规则
    //         "-q",      // 安静模式（可有可无）
    //         "-n8",     // 忽略“非 ASCII 字符”警告 —— 中文字符
    //         "-n18",    // 忽略标点前后空格这类（中文排版经常触发）
    //         "-n30"     // 忽略标点间距相关（中文符号也会触发）
    //   ],

    // ===================================================================
    // 八、 格式化（Formatting）
    // ===================================================================
    "latex-workshop.formatting.latex": "latexindent",
    "latex-workshop.formatting.latexindent.path": "latexindent",
    "latex-workshop.formatting.latexindent.args": [
        "-c",
        "%DIR%/",
        "%TMPFILE%",
        "-y=defaultIndent: '%INDENT%'"
    ],

    // ===================================================================
    // 九、 词数统计（Word Count）
    // ===================================================================
    "latex-workshop.texcount.autorun": "onSave",
    "latex-workshop.texcount.args": [
        "-merge",
        "-inc",
        "-total",
        "-ch",
        "-utf8"
    ],

    // ===================================================================
    // 十、 智能感知与大纲
    // ===================================================================
    "latex-workshop.intellisense.update.aggressive.enabled": true,
    "latex-workshop.intellisense.update.delay": 800,
    "latex-workshop.hover.preview.enabled": true,
    "latex-workshop.hover.ref.enabled": true,
    "latex-workshop.hover.citation.enabled": true,
    "latex-workshop.bind.enter.key": true,
    "latex-workshop.view.outline.enabled": true,
    "latex-workshop.view.outline.sections": [
        "part",
        "chapter",
        "section",
        "subsection",
        "subsubsection",
        "paragraph"
    ],
    "latex-workshop.view.outline.floats.enabled": true,

    // ===================================================================
    // 十一、 外部依赖查找
    // ===================================================================
    "latex-workshop.kpsewhich.bibtex.enabled": true,
    "latex-workshop.kpsewhich.class.enabled": true,
    "latex-workshop.latex.bibDirs": [
        "%DIR%/bib"
    ]
}